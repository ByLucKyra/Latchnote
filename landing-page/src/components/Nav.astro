---
import { Icon } from "astro-icon/components";
import type { Copy } from "../content/copy";

interface Props {
  t: Copy;
}

const { t } = Astro.props;

const links = [
  { href: "#how", label: t.nav.how },
  { href: "#output", label: t.nav.output },
  { href: "#waitlist", label: t.nav.pricing },
  { href: "#faq", label: t.nav.faq },
];
---

<header
  class="sticky top-0 z-40 border-b border-line/70 bg-bg/85 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-[1180px] items-center gap-6 px-5 sm:px-8"
    aria-label="Primary"
  >
    <a href="#main" class="flex shrink-0 items-center gap-2 font-medium tracking-tight">
      <Icon name="ph:waveform-bold" class="size-5 text-accent" aria-hidden="true" />
      <span class="text-[17px]">Latchnote</span>
    </a>

    <ul class="ml-auto hidden items-center gap-7 text-[14px] text-muted lg:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="transition-colors hover:text-ink">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-1.5 lg:ml-0">
      <a
        href={t.nav.otherLangHref}
        class="rounded-control px-2.5 py-1.5 font-mono text-[12px] tracking-wide text-muted transition-colors hover:bg-sunken hover:text-ink"
        aria-label={t.nav.otherLangLabel}
      >
        {t.nav.otherLangShort}
      </a>

      <button
        type="button"
        data-theme-toggle
        class="rounded-control p-2 text-muted transition-colors hover:bg-sunken hover:text-ink"
        aria-label={t.nav.themeLabel}
      >
        <Icon name="ph:circle-half-bold" class="size-[18px]" aria-hidden="true" />
      </button>

      <a
        href="#waitlist"
        class="ml-1 rounded-control bg-accent px-4 py-2 text-[14px] font-medium whitespace-nowrap text-accent-fg transition-transform hover:bg-accent-strong active:translate-y-px"
      >
        {t.nav.cta}
      </a>
    </div>
  </nav>
</header>
