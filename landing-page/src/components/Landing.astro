---
import { Icon } from "astro-icon/components";
import Nav from "./Nav.astro";
import LiveSessionDemo from "./LiveSessionDemo";
import HotkeyDemo from "./HotkeyDemo";
import WaitlistForm from "./WaitlistForm";
import type { Copy } from "../content/copy";
import { inlineIcon } from "../lib/icon";

interface Props {
  t: Copy;
}

const { t } = Astro.props;

// Phosphor glyphs resolved at build time, so the islands ship no icon library.
const pinIcon = inlineIcon("ph:push-pin-fill");
const demoIcons = { pin: pinIcon, replay: inlineIcon("ph:arrow-counter-clockwise-bold") };
const waitlistIcons = {
  check: inlineIcon("ph:check-circle-fill"),
  spinner: inlineIcon("ph:circle-notch-bold"),
};

const markdown = `# Session: Backend Fundamentals
**Date:** 2026-08-29 20:14

---

## [00:12:40]

### Structured notes

- Connection pooling reuses open database connections instead of opening one per request
- Default pool size in the example is 10, raised through max_overflow
- Pool exhaustion shows up as latency, not as an error

## [00:14:05]

📌 **cek pool_size default**

## [00:14:52]

Jadi kalau pool-nya habis, request-nya bukan gagal, tapi antre. That is why the latency graph spikes before anything errors out.
`;
---

<Nav t={t} />

<main id="main">
  <!-- Hero: asymmetric split, copy left, the running session right. -->
  <section class="mx-auto max-w-[1180px] px-5 pt-14 pb-20 sm:px-8 sm:pt-20 sm:pb-28">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16">
      <div>
        <p
          class="mb-5 inline-flex items-center rounded-control bg-accent-soft px-2.5 py-1 text-[12px] font-medium tracking-wide text-accent uppercase"
        >
          {t.hero.eyebrow}
        </p>
        <h1 class="text-[38px] leading-[1.08] font-medium tracking-tight sm:text-[52px] lg:text-[58px]">
          {t.hero.headlineTop}<br />
          <span class="text-muted">{t.hero.headlineBottom}</span>
        </h1>
        <p class="mt-6 max-w-[46ch] text-[17px] leading-relaxed text-muted">
          {t.hero.sub}
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href="#waitlist"
            class="rounded-control bg-accent px-5 py-3 text-[15px] font-medium whitespace-nowrap text-accent-fg transition-transform hover:bg-accent-strong active:translate-y-px"
          >
            {t.hero.ctaPrimary}
          </a>
          <a
            href="#output"
            class="rounded-control border border-line px-5 py-3 text-[15px] font-medium whitespace-nowrap transition-colors hover:bg-sunken"
          >
            {t.hero.ctaSecondary}
          </a>
        </div>
      </div>

      <div>
        <LiveSessionDemo client:idle labels={t.demo} icons={demoIcons} />
        <p class="mt-3 px-1 text-[12px] text-muted">{t.demo.caption}</p>
      </div>
    </div>
  </section>

  <!-- Problem: editorial statement paired with one photograph. -->
  <section class="border-t border-line bg-sunken">
    <div
      class="mx-auto grid max-w-[1180px] gap-10 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-16"
    >
      <div data-reveal>
        <h2 class="max-w-[16ch] text-[30px] leading-[1.15] font-medium tracking-tight sm:text-[40px]">
          {t.problem.heading}
        </h2>
        <div class="mt-7 grid max-w-[60ch] gap-4 text-[16px] leading-relaxed text-muted">
          <p>{t.problem.body1}</p>
          <p>{t.problem.body2}</p>
        </div>
      </div>

      <!-- TODO: replace with a photograph of the real product in use before launch. -->
      <img
        src="https://picsum.photos/seed/latchnote-night-study/900/1000?grayscale"
        alt={t.problem.imageAlt}
        width="900"
        height="1000"
        loading="lazy"
        decoding="async"
        class="w-full rounded-card border border-line object-cover contrast-[1.05] lg:aspect-[9/10]"
        data-reveal
      />
    </div>
  </section>

  <!-- How it works: stepped vertical list, one hairline per step. -->
  <section id="how" class="mx-auto max-w-[1180px] px-5 py-20 sm:px-8 sm:py-28">
    <h2 class="max-w-[18ch] text-[30px] leading-[1.15] font-medium tracking-tight sm:text-[40px]">
      {t.how.heading}
    </h2>

    <ol class="mt-12 grid gap-px overflow-hidden rounded-card border border-line bg-line">
      {
        t.how.steps.map((step, index) => (
          <li
            class="grid gap-2 bg-bg px-5 py-7 sm:grid-cols-[190px_minmax(0,1fr)] sm:gap-8 sm:px-8"
            data-reveal
            style={`--reveal-delay:${index * 70}ms`}
          >
            <h3 class="text-[17px] font-medium tracking-tight">{step.name}</h3>
            <p class="max-w-[62ch] text-[15px] leading-relaxed text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Micro-notes: the interaction the whole product is built around. -->
  <section class="border-y border-line bg-sunken">
    <div
      class="mx-auto grid max-w-[1180px] gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-2 lg:items-center lg:gap-16"
    >
      <div data-reveal>
        <h2 class="max-w-[15ch] text-[30px] leading-[1.15] font-medium tracking-tight sm:text-[40px]">
          {t.hotkey.heading}
        </h2>
        <p class="mt-6 max-w-[52ch] text-[16px] leading-relaxed text-muted">{t.hotkey.body}</p>
        <p class="mt-6 max-w-[52ch] border-l-2 border-accent pl-4 text-[15px] leading-relaxed">
          {t.hotkey.evidence}
        </p>
      </div>

      <div data-reveal>
        <HotkeyDemo client:visible labels={t.hotkey} pinIcon={pinIcon} />
      </div>
    </div>
  </section>

  <!-- Output: the actual file the app writes. -->
  <section id="output" class="mx-auto max-w-[1180px] px-5 py-20 sm:px-8 sm:py-28">
    <div class="max-w-[52ch]" data-reveal>
      <h2 class="text-[30px] leading-[1.15] font-medium tracking-tight sm:text-[40px]">
        {t.output.heading}
      </h2>
      <p class="mt-6 text-[16px] leading-relaxed text-muted">{t.output.body}</p>
    </div>

    <figure
      class="mt-10 overflow-hidden rounded-card border border-line bg-raised shadow-[var(--shadow)]"
      data-reveal
    >
      <figcaption class="flex items-center gap-3 border-b border-line px-4 py-3">
        <Icon name="ph:file-text" class="size-4 shrink-0 text-muted" aria-hidden="true" />
        <span class="truncate font-mono text-[12px] text-muted">{t.output.filename}</span>
        <button
          type="button"
          data-copy-markdown
          data-label-copy={t.output.copy}
          data-label-copied={t.output.copied}
          class="ml-auto shrink-0 rounded-control px-2 py-1 text-[12px] text-muted transition-colors hover:bg-sunken hover:text-ink"
        >
          {t.output.copy}
        </button>
      </figcaption>
      <pre
        id="markdown-sample"
        class="overflow-x-auto px-4 py-5 font-mono text-[13px] leading-[1.75] sm:px-6"><code>{markdown}</code></pre>
    </figure>
  </section>

  <!-- Positioning: one card per alternative, no row-by-row hairline table. -->
  <section class="border-t border-line bg-sunken">
    <div class="mx-auto max-w-[1180px] px-5 py-20 sm:px-8 sm:py-28">
      <h2 class="text-[30px] leading-[1.15] font-medium tracking-tight sm:text-[40px]">
        {t.comparison.heading}
      </h2>

      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {
          t.comparison.columns.map((column, columnIndex) => (
            <div
              class={`rounded-card border p-6 ${
                columnIndex === 0 ? "border-accent bg-raised" : "border-line bg-bg"
              }`}
              data-reveal
              style={`--reveal-delay:${columnIndex * 80}ms`}
            >
              <h3
                class={`text-[16px] font-medium tracking-tight ${
                  columnIndex === 0 ? "text-accent" : ""
                }`}
              >
                {column}
              </h3>
              <dl class="mt-5 grid gap-4">
                {t.comparison.rows.map((row) => (
                  <div>
                    <dt class="text-[12px] text-muted">{row.label}</dt>
                    <dd class="mt-0.5 text-[15px] leading-snug">{row.values[columnIndex]}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pricing is genuinely undecided, so the section asks instead of claiming. -->
  <section id="waitlist" class="mx-auto max-w-[1180px] px-5 py-20 sm:px-8 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
      <div data-reveal>
        <h2 class="max-w-[16ch] text-[30px] leading-[1.15] font-medium tracking-tight sm:text-[40px]">
          {t.waitlist.heading}
        </h2>
        <p class="mt-6 max-w-[52ch] text-[16px] leading-relaxed text-muted">{t.waitlist.body}</p>
      </div>

      <div data-reveal>
        <WaitlistForm client:visible labels={t.waitlist} icons={waitlistIcons} />
      </div>
    </div>
  </section>

  <!-- FAQ: native disclosure, keyboard accessible without any JavaScript. -->
  <section id="faq" class="border-t border-line bg-sunken">
    <div class="mx-auto max-w-[1180px] px-5 py-20 sm:px-8 sm:py-28">
      <h2 class="text-[30px] leading-[1.15] font-medium tracking-tight sm:text-[40px]">
        {t.faq.heading}
      </h2>

      <div class="mt-10 max-w-[70ch]">
        {
          t.faq.items.map((item) => (
            <details class="group border-b border-line">
              <summary class="flex cursor-pointer list-none items-center gap-4 py-5 text-[16px] font-medium">
                {item.q}
                <Icon
                  name="ph:plus-bold"
                  class="ml-auto size-4 shrink-0 text-muted transition-transform duration-300 group-open:rotate-45"
                  aria-hidden="true"
                />
              </summary>
              <p class="max-w-[62ch] pb-6 text-[15px] leading-relaxed text-muted">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</main>

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-[1180px] flex-col gap-6 px-5 py-12 sm:flex-row sm:items-end sm:justify-between sm:px-8"
  >
    <div>
      <p class="flex items-center gap-2 font-medium tracking-tight">
        <Icon name="ph:waveform-bold" class="size-4 text-accent" aria-hidden="true" />
        Latchnote
      </p>
      <p class="mt-2 max-w-[42ch] text-[14px] text-muted">{t.footer.tagline}</p>
    </div>
    <div class="text-[13px] text-muted sm:text-right">
      <p>{t.footer.builtBy}</p>
      <p class="mt-1">© 2026 Latchnote. {t.footer.rights}</p>
    </div>
  </div>
</footer>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy-markdown]");
  const sample = document.querySelector<HTMLElement>("#markdown-sample");

  if (button && sample) {
    let reset: number | undefined;

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(sample.innerText);
        button.textContent = button.dataset.labelCopied ?? "Copied";
        window.clearTimeout(reset);
        reset = window.setTimeout(() => {
          button.textContent = button.dataset.labelCopy ?? "Copy";
        }, 2000);
      } catch {
        // Clipboard access can be denied; the text stays selectable either way.
      }
    });
  }
</script>
