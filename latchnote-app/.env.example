# Add real values only to latchnote-app/.env (never commit it).
# Settings reload before each session; process environment overrides this file.
LATCHNOTE_NOTES_DIR=notes
LATCHNOTE_DATA_DIR=data
LATCHNOTE_WHISPER_MODEL=base
LATCHNOTE_WHISPER_LANGUAGE=
LATCHNOTE_WHISPER_THREADS=2
LATCHNOTE_WHISPER_WINDOW_SECONDS=5

# Optional: a provider's OpenAI-compatible API base (including /v1 if required).
# Leave blank for completely local raw-only notes.
NOTES_AI_BASE_URL=
NOTES_AI_API_KEY=
NOTES_AI_MODEL=
# Optional UTF-8 file of formatting preferences; blank uses Latchnote's standard.
LATCHNOTE_NOTES_FORMAT=
